{
  "name": "volva-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volva design system: tokens + Twig (Drupal SDC) components + Flutter package",
  "scripts": {
    "tokens": "node style-dictionary.config.mjs",
    "check": "node scripts/check-components.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "build:drupal": "npm run tokens && node scripts/build-drupal-theme.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "js-yaml": "5.5.0",
    "storybook": "10.6.3",
    "style-dictionary": "5.7.0",
    "vite": "7.3.7",
    "vite-plugin-twig-drupal": "1.6.2"
  }
}
