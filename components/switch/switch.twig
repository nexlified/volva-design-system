{% set attrs = attributes ?: create_attribute() %}
{% set field_id = id|default('vds-switch-' ~ name|default('field') ~ (value ? '-' ~ value : '')) %}
<div{{ attrs.addClass(error ? ['vds-switch', 'has-error'] : ['vds-switch']) }}>
  <label class="vds-switch__row" for="{{ field_id }}">
    <input class="vds-switch__control" type="checkbox" role="switch" id="{{ field_id }}" name="{{ name }}"{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled %} disabled{% endif %}{% if error %} aria-invalid="true" aria-describedby="{{ field_id }}-msg"{% elseif help %} aria-describedby="{{ field_id }}-msg"{% endif %}>
    <span class="vds-switch__label">{{ label }}</span>
  </label>
  {% if error %}<p class="vds-switch__msg vds-switch__msg--error" id="{{ field_id }}-msg">{{ error }}</p>
  {% elseif help %}<p class="vds-switch__msg" id="{{ field_id }}-msg">{{ help }}</p>{% endif %}
</div>
