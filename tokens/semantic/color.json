{
  "color": {
    "$type": "color",
    "brand": {
      "default": { "$value": "{palette.brand.600}" },
      "hover": { "$value": "{palette.brand.700}" },
      "active": { "$value": "{palette.brand.800}" },
      "subtle": { "$value": "{palette.brand.50}" },
      "on": { "$value": "{palette.neutral.0}" }
    },
    "surface": {
      "default": { "$value": "{palette.neutral.0}" },
      "subtle": { "$value": "{palette.neutral.50}" },
      "muted": { "$value": "{palette.neutral.100}" },
      "inverse": { "$value": "{palette.neutral.900}" }
    },
    "text": {
      "default": { "$value": "{palette.neutral.900}" },
      "muted": { "$value": "{palette.neutral.600}" },
      "subtle": { "$value": "{palette.neutral.500}" },
      "inverse": { "$value": "{palette.neutral.0}" },
      "link": { "$value": "{palette.brand.700}" }
    },
    "border": {
      "default": { "$value": "{palette.neutral.200}" },
      "strong": { "$value": "{palette.neutral.300}" },
      "focus": { "$value": "{palette.brand.500}" }
    },
    "status": {
      "success": { "$value": "{palette.success.700}" },
      "successBg": { "$value": "{palette.success.50}" },
      "warning": { "$value": "{palette.warning.700}" },
      "warningBg": { "$value": "{palette.warning.50}" },
      "danger": { "$value": "{palette.danger.600}" },
      "dangerBg": { "$value": "{palette.danger.50}" },
      "info": { "$value": "{palette.info.700}" },
      "infoBg": { "$value": "{palette.info.50}" }
    },
    "rating": { "$value": "{palette.warning.500}" }
  }
}
