{
  "chip": {
    "height": { "$type": "dimension", "$value": "32px" },
    "paddingX": { "$type": "dimension", "$value": "{space.3}" },
    "radius": { "$type": "dimension", "$value": "{radius.full}" },
    "fontSize": { "$type": "dimension", "$value": "{font.size.sm}" },
    "bg": { "$type": "color", "$value": "{color.surface.default}" },
    "fg": { "$type": "color", "$value": "{color.text.default}" },
    "border": { "$type": "color", "$value": "{color.border.strong}" },
    "bgActive": { "$type": "color", "$value": "{color.brand.subtle}" },
    "fgActive": { "$type": "color", "$value": "{color.brand.hover}" },
    "borderActive": { "$type": "color", "$value": "{color.brand.default}" }
  }
}
